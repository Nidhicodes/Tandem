{
  "name": "tandem-copy-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "bun x cre-setup",
    "typecheck": "tsc --noEmit",
