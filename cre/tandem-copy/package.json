    "simulate": "cd .. && cre workflow simulate tandem-copy --target staging-settings"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.23.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "bun": "1.4.3",
    "typescript": "5.9.3"
  }
}
