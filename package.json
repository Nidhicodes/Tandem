{
  "name": "tandem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trade in tandem with the best perp traders. One passkey, no seed phrase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "probe:perpl": "node --experimental-strip-types scripts/probe-perpl.ts",
    "test": "tsx --test tests/*.test.ts",
    "deploy:vault": "tsx --env-file=.env.local scripts/deploy-vault.ts",
    "demo:setup": "tsx --env-file=.env.local scripts/demo-leaders.ts setup",
    "demo:run": "tsx --env-file=.env.local scripts/demo-leaders.ts run"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "solc": "0.8.37",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
