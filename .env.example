# Deployer/sponsor wallet (testnet only). Funds new passkey accounts with a little MON for gas.
# Keep only a small float here. Never commit the real value.
SPONSOR_PRIVATE_KEY=0x

# Envio HyperSync token (free: https://app.envio.dev/api-tokens). Without it the
# leaderboard falls back to the public RPC and only sees the last ~10 minutes.
ENVIO_API_TOKEN=

# GraphQL endpoint of the deployed Tandem indexer (./indexer on Envio Cloud).
# When set, the leaderboard reads pre-aggregated stats from it instead of scanning logs.
ENVIO_GRAPHQL_URL=
